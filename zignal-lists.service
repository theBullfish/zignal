[Unit]
Description=zignal LISTS scanner — cross-system unfinished BIBLE-item surface
After=network-online.target zignal-http.service

[Service]
Type=oneshot
User=watchdog
WorkingDirectory=/mnt/work/zignal
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m zignal.lists.cli
StandardOutput=journal
StandardError=journal
